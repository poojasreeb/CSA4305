/* Reset */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#f4f4f4;
    line-height:1.6;
}

/* Header */
header{
    background:#2c3e50;
    color:white;
    text-align:center;
    padding:20px;
}

/* Navigation */
nav{
    display:flex;
    justify-content:center;
    gap:20px;
    background:#34495e;
    padding:15px;
}

nav a{
    color:white;
    text-decoration:none;
}

/* Flex Layout */
.container{
    display:flex;
    gap:20px;
    padding:20px;
}

/* Main Content */
.content{
    flex:3;
    background:white;
    padding:20px;
    border-radius:8px;
}

/* Sidebar */
.sidebar{
    flex:1;
    background:white;
    padding:20px;
    border-radius:8px;
}

/* Footer */
footer{
    background:#2c3e50;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}

/* Tablet View */
@media(max-width:768px){

.container{
    flex-direction:column;
}

}

/* Mobile View */
@media(max-width:480px){

nav{
    flex-direction:column;
    align-items:center;
}

header h1{
    font-size:22px;
}

.container{
    padding:10px;
}

}
