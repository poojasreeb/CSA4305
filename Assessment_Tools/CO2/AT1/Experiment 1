<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Responsive Retail Website</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, sans-serif;
    background:#f4f4f4;
}

/* Header */
header{
    background:#2c3e50;
    color:white;
    text-align:center;
    padding:20px;
}

/* Navigation */
nav{
    background:#34495e;
}

nav ul{
    display:flex;
    justify-content:center;
    list-style:none;
    flex-wrap:wrap;
}

nav ul li{
    margin:15px;
}

nav ul li a{
    color:white;
    text-decoration:none;
    font-weight:bold;
}

nav ul li a:hover{
    color:yellow;
}

/* Main Layout */
.container{
    display:flex;
    gap:20px;
    padding:20px;
}

/* Content */
.content{
    flex:3;
}

/* Product Cards */
.products{
    display:flex;
    flex-wrap:wrap;
    gap:20px;
}

.card{
    width:250px;
    background:white;
    border-radius:10px;
    box-shadow:0 2px 8px rgba(0,0,0,0.2);
    padding:15px;
    text-align:center;
}

.card img{
    width:100%;
    height:auto;
    border-radius:8px;
}

.card h3{
    margin:10px 0;
}

.card p{
    margin-bottom:15px;
}

.card button{
    background:#3498db;
    color:white;
    border:none;
    padding:10px 15px;
    border-radius:5px;
    cursor:pointer;
}

.card button:hover{
    background:#2980b9;
}

/* Sidebar */
.sidebar{
    flex:1;
    background:white;
    padding:20px;
    border-radius:10px;
    box-shadow:0 2px 8px rgba(0,0,0,0.2);
}

.sidebar h2{
    margin-bottom:15px;
}

.sidebar ul{
    list-style:none;
}

.sidebar li{
    padding:10px 0;
    border-bottom:1px solid #ddd;
}

/* Footer */
footer{
    background:#2c3e50;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}

/* Tablet */
@media(max-width:768px){

.container{
    flex-direction:column;
}

.products{
    justify-content:center;
}

}

/* Mobile */
@media(max-width:480px){

nav ul{
    flex-direction:column;
    align-items:center;
}

.card{
    width:100%;
}

header h1{
    font-size:24px;
}

.container{
    padding:10px;
}

}
</style>

</head>
<body>

<header>
    <h1>Retail Store</h1>
</header>

<nav>
    <ul>
        <li><a href="#">Home</a></li>
        <li><a href="#">Products</a></li>
        <li><a href="#">Categories</a></li>
        <li><a href="#">Offers</a></li>
        <li><a href="#">Contact</a></li>
    </ul>
</nav>

<div class="container">

    <section class="content">

        <h2>Featured Products</h2>
        <br>

        <div class="products">

            <div class="card">
                <img src="https://via.placeholder.com/250x150" alt="Smart Watch">
                <h3>Smart Watch</h3>
                <p>Latest smartwatch with fitness tracking.</p>
                <button>Buy Now</button>
            </div>

            <div class="card">
                <img src="https://via.placeholder.com/250x150" alt="Headphones">
                <h3>Wireless Headphones</h3>
                <p>Premium sound quality with noise cancellation.</p>
                <button>Buy Now</button>
            </div>

            <div class="card">
                <img src="https://via.placeholder.com/250x150" alt="Smartphone">
                <h3>Smartphone</h3>
                <p>High-performance smartphone with excellent camera.</p>
                <button>Buy Now</button>
            </div>

        </div>

    </section>

    <aside class="sidebar">

        <h2>Latest Offers</h2>

        <ul>
            <li>🔥 50% OFF on Electronics</li>
            <li>🎁 Buy 1 Get 1 Free</li>
            <li>🚚 Free Home Delivery</li>
            <li>💳 10% Cashback on Credit Cards</li>
            <li>🛒 Weekend Mega Sale</li>
        </ul>

    </aside>

</div>

<footer>
    <p>&copy; 2026 Retail Store. All Rights Reserved.</p>
</footer>

</body>
</html>
